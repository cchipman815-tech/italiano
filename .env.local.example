# Every env var the app reads. Real values live in .env.local (this Mac) and in
# the Vercel project (production). A var referenced in code but missing from
# Vercel is undefined at runtime, not at build time — so add new ones here and
# to Vercel together. `vercel env pull .env.local` fills in local values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=
GOOGLE_TRANSLATE_API_KEY=
ANTHROPIC_API_KEY=
